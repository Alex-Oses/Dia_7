# Dia 7 (ASIX) - configuracion del servicio de transcripcion.
# NO SUBIR ESTE FICHERO: esta en .gitignore porque contiene la API Key.

# Credencial de Gemini. Se obtiene en https://aistudio.google.com > Get API key
# IMPORTANTE: esta key solo puede vivir en el servidor. Si llega al navegador,
# cualquiera que abra las herramientas del navegador puede leerla y usarla.
GEMINI_API_KEY=

# Modelo preferido. Si se deja vacio se usa la cadena de fallback:
#   3.7 -> 3.6 -> 3.5 -> 3.5-lite -> flash-latest -> flash-lite-latest
GEMINI_MODEL=

# Limites del endpoint
MAX_AUDIO_BYTES=10485760
MAX_AUDIO_SEGUNDOS=300
GEMINI_TIMEOUT=120

# Peticiones por cliente y ventana (protege la cuota compartida del aula)
RATE_LIMITE=10
RATE_VENTANA_S=60

# Origenes autorizados a llamar a la API desde el navegador (CORS).
# No poner "*": con una key en el servidor, un origen abierto permitiria que
# cualquier web usase vuestra cuota.
CORS_ORIGENES=http://localhost:8000,http://127.0.0.1:8000,http://localhost:5500,http://127.0.0.1:5500
